// Claude Code settings, kept by hand.
{
	// The model for new sessions.
	"model": "sonnet",
	"permissions": {
		"allow": ["Bash(npm test)", "Read(~/notes/**)",], // trailing comma on purpose
	},
	/* Hooks other tools added. */
	"hooks": {
		"Stop": [
			{
				"hooks": [{ "type": "command", "command": "say done" }],
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "/home/teen/.local/bin/pairtime",
						"args": [
							"hook",
							"--harness",
							"claude_code",
							"--event",
							"Stop"
						]
					}
				]
			},
		],
		"PostToolUse": [
			{
				"matcher": "Write|Edit|MultiEdit",
				"hooks": [{ "type": "command", "command": "/home/teen/.git-ai/bin/git-ai checkpoint claude --hook-input stdin" }]
			},
			{
				"matcher": "Edit|Write|Bash",
				"hooks": [
					{
						"type": "command",
						"command": "/home/teen/.local/bin/pairtime",
						"args": [
							"hook",
							"--harness",
							"claude_code",
							"--event",
							"PostToolUse"
						]
					}
				]
			}
		], // git-ai
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/home/teen/.local/bin/pairtime",
						"args": [
							"hook",
							"--harness",
							"claude_code",
							"--event",
							"SessionStart"
						]
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/home/teen/.local/bin/pairtime",
						"args": [
							"hook",
							"--harness",
							"claude_code",
							"--event",
							"UserPromptSubmit"
						]
					}
				]
			}
		],
		"StopFailure": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/home/teen/.local/bin/pairtime",
						"args": [
							"hook",
							"--harness",
							"claude_code",
							"--event",
							"StopFailure"
						]
					}
				]
			}
		],
		"Notification": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/home/teen/.local/bin/pairtime",
						"args": [
							"hook",
							"--harness",
							"claude_code",
							"--event",
							"Notification"
						]
					}
				]
			}
		],
		"PermissionRequest": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/home/teen/.local/bin/pairtime",
						"args": [
							"hook",
							"--harness",
							"claude_code",
							"--event",
							"PermissionRequest"
						]
					}
				]
			}
		],
		"SubagentStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/home/teen/.local/bin/pairtime",
						"args": [
							"hook",
							"--harness",
							"claude_code",
							"--event",
							"SubagentStart"
						]
					}
				]
			}
		],
		"SubagentStop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/home/teen/.local/bin/pairtime",
						"args": [
							"hook",
							"--harness",
							"claude_code",
							"--event",
							"SubagentStop"
						]
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/home/teen/.local/bin/pairtime",
						"args": [
							"hook",
							"--harness",
							"claude_code",
							"--event",
							"SessionEnd"
						]
					}
				]
			}
		]
	},
}
