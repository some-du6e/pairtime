					{
						"type": "command",
						"command": "/home/teen/.local/bin/pairtime",
						"args": [
							"hook",
							"--harness",
							"claude_code",
							"--event",
							"PostToolUse"
						]
					}
				]
			}
		],
		"SubagentStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/home/teen/.local/bin/pairtime",
						"args": [
							"hook",
							"--harness",
							"claude_code",
							"--event",
