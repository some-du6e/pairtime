						"type": "command",
						"command": "/home/teen/.local/bin/pairtime",
						"args": [
							"hook",
							"--harness",
							"claude_code",
							"--event",
							"Stop"
						]
					}
				]
			}
		],
		"StopFailure": [
			{
				"hooks": [
					{
						"type": "command",
