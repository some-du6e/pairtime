{
	"model": "sonnet",
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup",
				"hooks": [
					{
						"type": "command",
						"command": "echo hi"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "/home/teen/.local/bin/pairtime",
						"args": [
							"hook",
							"--harness",
							"claude_code",
							"--event",
							"SessionStart"
						]
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/home/teen/.local/bin/pairtime",
						"args": [
							"hook",
							"--harness",
							"claude_code",
							"--event",
							"UserPromptSubmit"
						]
					}
				]
			}
		],
		"Stop": [
