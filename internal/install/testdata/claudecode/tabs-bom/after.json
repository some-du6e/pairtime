						"args": [
							"hook",
							"--harness",
							"claude_code",
							"--event",
							"Notification"
						]
					}
				]
			}
		],
		"PermissionRequest": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/home/teen/.local/bin/pairtime",
						"args": [
							"hook",
							"--harness",
