{
  "$comment": "Test cases that internal/coach/text and its TypeScript port, web/src/local/text.ts, both run, so the CLI views and the dashboard spell time, name agents and round shares alike (DESIGN 3.8). text_test.go reads every table. web/src/local/text.test.ts runs duration, clock, percentages and words against text.ts. web/src/local/copy.test.ts builds the dashboard's scolding matcher from scolding the way text_test.go builds its own, (?i)(?:^|[^\\w/])(the alternatives joined with |)\\b plus each mark wherever it appears, and runs its cases. A words case names the Go function and gives its arguments as strings: Phrase and Fill take one and then pairs of name and value, Day takes a YYYY-MM-DD date and Clocktime an RFC 3339 time in UTC. Cases JSON can't hold, such as bytes that aren't UTF-8 or NaN, stay in their own language's test.",
  "duration": [
    {"name": "nothing is 0m", "s": 0, "want": "0m"},
    {"name": "less than a second is 0m", "s": 0.5, "want": "0m"},
    {"name": "a negative number is 0m", "s": -30, "want": "0m"},
    {"name": "seconds alone below a minute", "s": 45, "want": "45s"},
    {"name": "a half second rounds down", "s": 45.5, "want": "45s"},
    {"name": "minutes and seconds below an hour", "s": 265, "want": "4m 25s"},
    {"name": "whole minutes drop the seconds", "s": 720, "want": "12m"},
    {"name": "hours and minutes from an hour up, seconds dropped", "s": 4339, "want": "1h 12m"},
    {"name": "whole hours drop the minutes", "s": 7200, "want": "2h"},
    {"name": "an hour and a few seconds is the hour", "s": 3605, "want": "1h"},
    {"name": "59 minutes 59 seconds stays below the hour", "s": 3599, "want": "59m 59s"},
    {"name": "SM 6.4's agent-only night", "s": 23180, "want": "6h 26m"},
    {"name": "a huge number doesn't overflow", "s": 1e300, "want": "277777777h 46m"}
  ],
  "clock": [
    {"name": "your time then the agent's, as DESIGN 3.8 writes it", "you": 4320, "level_c": 0, "calibrating": false, "agents": [{"name": "Claude", "s": 9600}], "want": "you 1h 12m · Claude 2h 40m"},
    {"name": "no agent time shows your time alone", "you": 265, "level_c": 0, "calibrating": false, "agents": [], "want": "you 4m 25s"},
    {"name": "an agent with no time is left out", "you": 265, "level_c": 0, "calibrating": false, "agents": [{"name": "Cursor", "s": 0.5}], "want": "you 4m 25s"},
    {"name": "two agents keep their order", "you": 60, "level_c": 0, "calibrating": false, "agents": [{"name": "Claude", "s": 9600}, {"name": "Codex", "s": 300}], "want": "you 1m · Claude 2h 40m · Codex 5m"},
    {"name": "level-C time is labeled on the clock (D11)", "you": 4320, "level_c": 1200, "calibrating": false, "agents": [{"name": "Claude", "s": 9600}], "want": "you 1h 12m, 20m level C · Claude 2h 40m"},
    {"name": "under a second of level C isn't labeled", "you": 4320, "level_c": 0.5, "calibrating": false, "agents": [{"name": "Claude", "s": 9600}], "want": "you 1h 12m · Claude 2h 40m"},
    {"name": "calibrating hides your time and keeps the agent's", "you": 4320, "level_c": 0, "calibrating": true, "agents": [{"name": "Claude", "s": 9600}], "want": "you calibrating · Claude 2h 40m"},
    {"name": "calibrating hides your level-C time too", "you": 4320, "level_c": 1200, "calibrating": true, "agents": [{"name": "Claude", "s": 9600}], "want": "you calibrating · Claude 2h 40m"},
    {"name": "nothing yet is 0m", "you": 0, "level_c": 0, "calibrating": false, "agents": [], "want": "you 0m"}
  ],
  "percentages": [
    {"name": "one part is 100", "parts": [265], "want": [100]},
    {"name": "thirds give the extra point to the first", "parts": [1, 1, 1], "want": [34, 33, 33]},
    {"name": "the largest remainder gets the extra point", "parts": [1, 2, 3.5], "want": [15, 31, 54]},
    {"name": "a zero part stays 0 and the rest add up to 100", "parts": [0, 3, 1], "want": [0, 75, 25]},
    {"name": "a tiny part can round to 0", "parts": [1, 999], "want": [0, 100]},
    {"name": "nothing positive is all zeros", "parts": [0, -1], "want": [0, 0]},
    {"name": "no parts is no percentages", "parts": [], "want": []},
    {"name": "SM 6.3's afternoon by level", "parts": [11640, 480, 300], "want": [94, 4, 2]}
  ],
  "words": [
    {"name": "claude_code's agent is Claude", "func": "Agent", "args": ["claude_code"], "want": "Claude"},
    {"name": "a harness en.json doesn't know is your agent", "func": "Agent", "args": ["zed"], "want": "your agent"},
    {"name": "reading names the agent", "func": "Kind", "args": ["reading_output", "Claude"], "want": "reading Claude's answers"},
    {"name": "an unknown kind shows its code", "func": "Kind", "args": ["juggling", "Claude"], "want": "juggling"},
    {"name": "an unknown kind's code can't reach the terminal raw", "func": "Kind", "args": ["jug\u001b]52;c;x\u0007", "Claude"], "want": "jug\ufffd]52;c;x\ufffd"},
    {"name": "agent-only time names the agent", "func": "AgentTime", "args": ["Cursor"], "want": "Cursor, working on its own"},
    {"name": "X.absent is away (D5)", "func": "Other", "args": ["X.absent", "Claude"], "want": "away"},
    {"name": "X.noprog that can no longer come back says what it was", "func": "Other", "args": ["X.noprog", "Claude"], "want": "past two hours without progress, counted at half"},
    {"name": "X.noprog that progress can still bring back is on hold (D5)", "func": "OnHold", "args": [], "want": "on hold: these come back when you fix it"},
    {"name": "the rewrite loop names the agent", "func": "Other", "args": ["X.rewrite_loop", "Codex"], "want": "Codex rewriting the same lines"},
    {"name": "X.agent_only isn't other time", "func": "Other", "args": ["X.agent_only", "Claude"], "want": ""},
    {"name": "level C says where it shows, as D-focus-unknown words it (D5, D11)", "func": "Level", "args": ["C"], "want": "this shows on your own dashboard, not on your profile, build days or most programs"},
    {"name": "Printable keeps plain text", "func": "Printable", "args": ["remind-bot {x} café"], "want": "remind-bot {x} café"},
    {"name": "Printable replaces control characters", "func": "Printable", "args": ["a\u001b[2Jb\u0007c\u000ad\u0009e"], "want": "a\ufffd[2Jb\ufffdc\ufffdd\ufffde"},
    {"name": "Printable replaces bidirectional formatting", "func": "Printable", "args": ["abc\u202edcba\u2066x"], "want": "abc\ufffddcba\ufffdx"},
    {"name": "a phrase fills its placeholders", "func": "Phrase", "args": ["session_span", "day", "Tuesday, November 24", "start", "07:40", "end", "07:45"], "want": "Tuesday, November 24, 07:40 to 07:45"},
    {"name": "a value with braces isn't filled again", "func": "Phrase", "args": ["session_last", "project", "{time}"], "want": "Your last session: {time}"},
    {"name": "a placeholder with no value stays", "func": "Fill", "args": ["you {time}"], "want": "you {time}"},
    {"name": "Sentence capitalizes the first letter", "func": "Sentence", "args": ["your agent, working on its own"], "want": "Your agent, working on its own"},
    {"name": "Sentence leaves an empty string", "func": "Sentence", "args": [""], "want": ""},
    {"name": "Day heads a day", "func": "Day", "args": ["2026-11-24"], "want": "Tuesday, November 24"},
    {"name": "Clocktime is 24-hour with a leading zero", "func": "Clocktime", "args": ["2026-11-24T07:04:00Z"], "want": "07:04"}
  ],
  "scolding": {
    "alternatives": [
      "streaks?",
      "don't break",
      "keep it up",
      "los(?:e|es|ing|t)",
      "miss(?:ed|es|ing)?",
      "behind",
      "lazy",
      "wast(?:e|ed|es|ing)",
      "only counted",
      "should",
      "must",
      "have to",
      "need to",
      "fail(?:ed|s|ing)?",
      "goals?",
      "targets?",
      "ratios?",
      "uncredited",
      "not counted",
      "doesn't count"
    ],
    "marks": ["%", "!"],
    "cases": [
      {"name": "a streak scolds", "s": "Keep your streak", "want": ["streak"]},
      {"name": "a word in capitals scolds as well", "s": "You MISSED a day", "want": ["MISSED"]},
      {"name": "a target and a ratio scold", "s": "your target ratio", "want": ["target", "ratio"]},
      {"name": "a percent sign scolds", "s": "40% of it", "want": ["%"]},
      {"name": "an exclamation mark scolds", "s": "Well done!", "want": ["!"]},
      {"name": "permission doesn't trip miss", "s": "you said no to a permission Claude asked for", "want": []},
      {"name": "submission doesn't trip miss", "s": "your submission", "want": []},
      {"name": "close doesn't trip lose", "s": "close the editor", "want": []},
      {"name": "duration and calibration don't trip ratio", "s": "the duration while calibration runs", "want": []},
      {"name": "a slash command named goal is its name, not a goal", "s": "the /goal prompt", "want": []},
      {"name": "goal as a word scolds", "s": "your goal for today", "want": ["goal"]},
      {"name": "wasted scolds as waste does", "s": "wasted time", "want": ["wasted"]}
    ]
  }
}
