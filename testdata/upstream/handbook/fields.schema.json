{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Format of handbook/fields.json",
  "description": "The YSWS handbook's submission and justification fields and its hours rules, as retrieved on the date in the file. Field names are the handbook's exact words. Everything else is our paraphrase.",
  "type": "object",
  "additionalProperties": false,
  "required": ["handbook", "base_url", "short_url", "retrieved", "pages", "submission_fields", "justification", "hours_rules", "spot_checks"],
  "properties": {
    "handbook": {"const": "YSWS Project Submission Guidelines"},
    "base_url": {"type": "string", "pattern": "^https://"},
    "short_url": {"type": "string", "pattern": "^https://"},
    "retrieved": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "last_updated", "sha256"],
        "properties": {
          "page": {"type": "string", "pattern": "\\.md$"},
          "last_updated": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Of the Markdown as retrieved, so a later reader can tell whether the page changed."}
        }
      }
    },
    "submission_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "always", "sometimes"],
      "properties": {
        "page": {"type": "string"},
        "always": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "sometimes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "when"],
            "properties": {"name": {"type": "string"}, "when": {"type": "string"}}
          }
        }
      }
    },
    "justification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "unified_field", "template_field", "how_fields_combine", "standard", "audience", "fields"],
      "properties": {
        "page": {"type": "string"},
        "unified_field": {"type": "string"},
        "template_field": {"type": "string"},
        "how_fields_combine": {"type": "string"},
        "standard": {"type": "string"},
        "audience": {"type": "string"},
        "fields": {"type": "array", "minItems": 7, "items": {"$ref": "#/$defs/justification_field"}}
      }
    },
    "hours_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "rules"],
      "properties": {
        "page": {"type": "string"},
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "rule"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z_]+$"},
              "rule": {"type": "string"},
              "numbers": {"type": "object"}
            }
          }
        }
      }
    },
    "spot_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "verdicts", "grounds", "resubmit"],
      "properties": {
        "page": {"type": "string"},
        "verdicts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "grounds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["number", "verdict", "ground"],
            "properties": {
              "number": {"type": "integer", "minimum": 1},
              "verdict": {"enum": ["Rejected", "Needs Changes"]},
              "ground": {"type": "string"}
            }
          }
        },
        "resubmit": {"type": "string"}
      }
    }
  },
  "$defs": {
    "date_ranges": {
      "type": "string",
      "pattern": "^[^,]+ (?:[1-9]|1[0-2])/(?:[1-9]|[12][0-9]|3[01])/[0-9]{4}-(?:[1-9]|1[0-2])/(?:[1-9]|[12][0-9]|3[01])/[0-9]{4}(, [^,]+ (?:[1-9]|1[0-2])/(?:[1-9]|[12][0-9]|3[01])/[0-9]{4}-(?:[1-9]|1[0-2])/(?:[1-9]|[12][0-9]|3[01])/[0-9]{4})*$",
      "description": "The handbook's format for Hackatime Project Name(s) and Date Range(s): comma-separated entries, each a project name, a space, and a M/D/YYYY-M/D/YYYY range with no zero padding, as in the handbook's example and DESIGN 9.3's remind-bot 11/1/2026-11/18/2026. A month is 1 to 12 and a day 1 to 31; the pattern doesn't check that the day exists in its month. A project name containing a comma can't be written in this format.",
      "examples": ["hackatime-project 7/20/2026-7/22/2026, hackatime-project-2 7/21/2026-7/23/2026", "remind-bot 11/1/2026-11/18/2026", "remind-bot 12/31/2026-1/1/2027"],
      "$comment": "Each x-invalid-examples string breaks one position, in this order: the first range's start month, start day, end month and end day, then a later range's, each zero-padded, then 0, then 13 for a month or 32 for a day.",
      "x-invalid-examples": [
        "remind-bot 01/1/2026-11/18/2026",
        "remind-bot 0/1/2026-11/18/2026",
        "remind-bot 13/1/2026-11/18/2026",
        "remind-bot 11/01/2026-11/18/2026",
        "remind-bot 11/0/2026-11/18/2026",
        "remind-bot 11/32/2026-11/18/2026",
        "remind-bot 11/1/2026-01/18/2026",
        "remind-bot 11/1/2026-0/18/2026",
        "remind-bot 11/1/2026-13/18/2026",
        "remind-bot 11/1/2026-11/08/2026",
        "remind-bot 11/1/2026-11/0/2026",
        "remind-bot 11/1/2026-11/32/2026",
        "remind-bot 11/1/2026-11/18/2026, cs2go 01/1/2026-11/8/2026",
        "remind-bot 11/1/2026-11/18/2026, cs2go 0/1/2026-11/8/2026",
        "remind-bot 11/1/2026-11/18/2026, cs2go 13/1/2026-11/8/2026",
        "remind-bot 11/1/2026-11/18/2026, cs2go 11/01/2026-11/8/2026",
        "remind-bot 11/1/2026-11/18/2026, cs2go 11/0/2026-11/8/2026",
        "remind-bot 11/1/2026-11/18/2026, cs2go 11/32/2026-11/8/2026",
        "remind-bot 11/1/2026-11/18/2026, cs2go 11/1/2026-01/8/2026",
        "remind-bot 11/1/2026-11/18/2026, cs2go 11/1/2026-0/8/2026",
        "remind-bot 11/1/2026-11/18/2026, cs2go 11/1/2026-13/8/2026",
        "remind-bot 11/1/2026-11/18/2026, cs2go 11/1/2026-11/08/2026",
        "remind-bot 11/1/2026-11/18/2026, cs2go 11/1/2026-11/0/2026",
        "remind-bot 11/1/2026-11/18/2026, cs2go 11/1/2026-11/32/2026"
      ]
    },
    "justification_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "include_when", "written_by", "content"],
      "properties": {
        "name": {"type": "string"},
        "include_when": {"type": "string"},
        "written_by": {"enum": ["automated", "human", "either"]},
        "content": {"type": "string"},
        "format": {"type": "string"},
        "example": {"$ref": "#/$defs/date_ranges"}
      }
    }
  }
}
