  "deliveries": [
    {
      "text": "Any 2xx answer acknowledges a delivery. Anything else makes Robert retry with the same deliveryId, 8 attempts over about 45 hours by Alchemize's comment, so receivers store the delivery ids they handled and acknowledge a repeat without acting on it again.",
      "sources": [
        {
          "repo": "hackclub/Alchemize",
          "file": "src/routes/api/telescreen/webhook/+server.ts",
          "lines": "6-8, 58-65"
