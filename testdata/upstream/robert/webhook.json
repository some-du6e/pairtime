          "repo": "hackclub/the-carnival",
          "file": "src/app/api/webhooks/telescreen/route.ts",
          "lines": "8-10, 60-65"
        }
      ]
    },
    {
      "text": "Carnival reads the delivery id from an X-Robert-Delivery header when the body has none.",
      "sources": [
        {
          "repo": "hackclub/the-carnival",
          "file": "src/app/api/webhooks/telescreen/route.ts",
          "lines": "54-58"
        }
      ]
    },
    {
      "text": "The webhook for an outcome decided in Robert's own UI carries no review note, only outcome.reason, so pixl also polls list_projects.",
      "sources": [
        {
          "repo": "hackclub/pixl",
          "file": "apps/internal-dashboard/lib/robert.ts",
          "lines": "194-196"
        }
      ]
    }
