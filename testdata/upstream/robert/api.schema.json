{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Format of robert/api.json",
  "description": "Robert's YSWS API as four public clients use it. Robert's own documentation needs a Hack Club sign-in, so every fact is reconstructed from client code and cites the client that shows it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["reconstructed", "base_url", "auth", "errors", "states", "score_bands", "project", "endpoints", "disagreements"],
  "properties": {
    "reconstructed": {"const": true},
    "base_url": {"type": "string", "pattern": "^https://"},
    "auth": {"$ref": "#/$defs/fact"},
    "errors": {"$ref": "#/$defs/fact"},
    "states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "meaning", "sources"],
      "properties": {
        "values": {"type": "array", "items": {"enum": ["awaiting_review", "awaiting_outcome", "rejected_fraud", "decided"]}, "minItems": 4, "uniqueItems": true},
        "meaning": {"type": "string"},
        "sources": {"$ref": "#/$defs/sources"}
      }
    },
    "score_bands": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["min", "max", "band", "meaning", "sources"],
        "properties": {
          "min": {"type": "integer", "minimum": 1, "maximum": 10},
          "max": {"type": "integer", "minimum": 1, "maximum": 10},
          "band": {"enum": ["fraud", "doubtful", "clean"]},
          "meaning": {"type": "string"},
          "sources": {"$ref": "#/$defs/sources"}
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "fields", "sources"],
      "properties": {
        "description": {"type": "string"},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
        "sources": {"$ref": "#/$defs/sources"}
      }
    },
    "endpoints": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/endpoint"}},
    "disagreements": {"type": "array", "items": {"$ref": "#/$defs/fact"}}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "file", "lines"],
      "properties": {
        "repo": {"enum": ["hackclub/the-carnival", "hackclub/pixl", "hackclub/trmnt", "hackclub/Alchemize"]},
        "file": {"type": "string"},
        "lines": {"type": "string", "pattern": "^[0-9]+(-[0-9]+)?(, [0-9]+(-[0-9]+)?)*$"}
      }
    },
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "sources"],
      "properties": {
        "text": {"type": "string"},
        "sources": {"$ref": "#/$defs/sources"}
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required", "meaning"],
      "properties": {
        "name": {"type": "string"},
        "type": {"type": "string"},
        "required": {"type": "boolean"},
        "meaning": {"type": "string"},
        "sources": {"$ref": "#/$defs/sources"}
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "path", "body", "returns", "sources"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z_]+$"},
        "method": {"enum": ["GET", "POST", "PATCH", "DELETE"]},
        "path": {"type": "string", "pattern": "^/api/v1/ysws/"},
        "query": {"type": "array", "items": {"$ref": "#/$defs/field"}},
        "body": {"type": "array", "items": {"$ref": "#/$defs/field"}},
        "returns": {"type": "string"},
        "errors": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "notes": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "sources": {"$ref": "#/$defs/sources"}
      }
    }
  }
}
