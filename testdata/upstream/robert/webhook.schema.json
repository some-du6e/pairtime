{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Format of robert/webhook.json",
  "description": "Robert's webhook signature scheme and payloads as receivers verify and read them, with test vectors. check.py recomputes every signature and replays every verification case.",
  "type": "object",
  "additionalProperties": false,
  "required": ["reconstructed", "scheme", "payloads", "deliveries", "signing_vectors", "verify_cases"],
  "properties": {
    "reconstructed": {"const": true},
    "scheme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp_header", "signature_header", "message", "mac", "key", "signature_format", "timestamp_format", "tolerance_s", "receiver_rule", "sources"],
      "properties": {
        "timestamp_header": {"const": "X-Robert-Timestamp"},
        "signature_header": {"const": "X-Robert-Signature"},
        "message": {"type": "string"},
        "mac": {"const": "HMAC-SHA256"},
        "key": {"type": "string"},
        "signature_format": {"type": "string"},
        "timestamp_format": {"type": "string"},
        "tolerance_s": {"const": 300},
        "receiver_rule": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "sources": {"$ref": "#/$defs/sources"}
      }
    },
    "payloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "when", "fields", "sources"],
        "properties": {
          "event": {"type": "string"},
          "when": {"type": "string"},
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type", "meaning"],
              "properties": {"name": {"type": "string"}, "type": {"type": "string"}, "meaning": {"type": "string"}}
            }
          },
          "sources": {"$ref": "#/$defs/sources"}
        }
      }
    },
    "deliveries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "sources"],
        "properties": {"text": {"type": "string"}, "sources": {"$ref": "#/$defs/sources"}}
      }
    },
    "signing_vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "secret", "timestamp", "body", "signature"],
        "properties": {
          "name": {"type": "string"},
          "secret": {"type": "string", "minLength": 1},
          "timestamp": {"type": "string", "pattern": "^[0-9]+$"},
          "body": {"type": "string", "description": "The raw request body, exactly. Its UTF-8 bytes are what gets signed."},
          "signature": {"type": "string", "pattern": "^sha256=[0-9a-f]{64}$"}
        }
      }
    },
    "verify_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "secret", "timestamp", "signature", "body", "now", "expect"],
        "properties": {
          "name": {"type": "string"},
          "secret": {"type": "string"},
          "timestamp": {"type": ["string", "null"], "description": "The X-Robert-Timestamp header, or null when it is missing."},
          "signature": {"type": ["string", "null"], "description": "The X-Robert-Signature header, or null when it is missing."},
          "body": {"type": "string"},
          "now": {"type": "number", "description": "The receiver's clock, in Unix seconds with fractions."},
          "expect": {"enum": ["accept", "reject"]}
        }
      }
    }
  },
  "$defs": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "file", "lines"],
        "properties": {
          "repo": {"enum": ["hackclub/the-carnival", "hackclub/pixl", "hackclub/trmnt", "hackclub/Alchemize"]},
          "file": {"type": "string"},
          "lines": {"type": "string", "pattern": "^[0-9]+(-[0-9]+)?(, [0-9]+(-[0-9]+)?)*$"}
        }
      }
    }
  }
}
