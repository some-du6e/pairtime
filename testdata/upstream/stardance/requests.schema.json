{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Format of stardance/requests.json",
  "description": "Every HTTP request Stardance's HackatimeService makes, described from the source at the pinned revision. Line numbers are in the file named at the top unless a citation names another.",
  "type": "object",
  "additionalProperties": false,
  "required": ["upstream", "revision", "file", "blob", "base_url", "query_encoding", "connections", "requests"],
  "properties": {
    "upstream": {"const": "hackclub/stardance"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "file": {"const": "app/services/hackatime_service.rb"},
    "blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "base_url": {"type": "string", "pattern": "^https://"},
    "query_encoding": {"type": "string"},
    "connections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/connection"}},
    "requests": {"type": "array", "minItems": 11, "items": {"$ref": "#/$defs/request"}}
  },
  "$defs": {
    "lines": {"type": "string", "pattern": "^[0-9]+(-[0-9]+)?(, [0-9]+(-[0-9]+)?)*$"},
    "cite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "lines"],
      "properties": {
        "file": {"type": "string"},
        "lines": {"$ref": "#/$defs/lines"},
        "what": {"type": "string"}
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {"name": {"type": "string"}, "value": {"type": "string"}}
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "prefix", "lines", "headers", "open_timeout_s", "read_timeout_s"],
      "properties": {
        "name": {"enum": ["connection", "admin_connection", "heartbeat_connection"]},
        "prefix": {"type": "string", "pattern": "^/api/"},
        "lines": {"$ref": "#/$defs/lines"},
        "headers": {"type": "array", "items": {"$ref": "#/$defs/header"}},
        "open_timeout_s": {"type": "integer", "minimum": 1},
        "read_timeout_s": {"type": "integer", "minimum": 1}
      }
    },
    "param": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "form", "example"],
      "properties": {
        "name": {"type": "string"},
        "form": {"type": "string", "description": "What the value is and where it comes from."},
        "example": {"type": "string", "description": "As it appears in the query string, before percent-encoding."},
        "sent": {"enum": ["always", "when given"]},
        "lines": {"$ref": "#/$defs/lines"}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stardance_method", "lines", "connection", "method", "path", "auth", "query", "reads", "on_failure", "callers"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z_]+$"},
        "stardance_method": {"type": "string"},
        "lines": {"$ref": "#/$defs/lines"},
        "connection": {"enum": ["connection", "admin_connection", "heartbeat_connection"]},
        "method": {"enum": ["GET", "POST"]},
        "path": {"type": "string", "pattern": "^/api/"},
        "fallback_path": {"type": "string", "pattern": "^/api/", "description": "The path Stardance retries without credentials when the first one fails."},
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "header"],
          "properties": {
            "kind": {"enum": ["none", "oauth_token", "api_key", "admin_key"]},
            "header": {"type": "string"},
            "fallback": {"type": "string"}
          }
        },
        "query": {"type": "array", "items": {"$ref": "#/$defs/param"}},
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": ["content_type", "form", "example"],
          "properties": {
            "content_type": {"const": "application/json"},
            "form": {"type": "string"},
            "example": {}
          }
        },
        "reads": {"type": "array", "items": {"type": "string"}, "description": "The response fields Stardance uses, as JSON paths with [] for each array element."},
        "on_failure": {"type": "string"},
        "callers": {"type": "array", "items": {"$ref": "#/$defs/cite"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
