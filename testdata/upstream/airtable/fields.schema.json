{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Format of airtable/fields.json",
  "description": "Airtable base, table and field names as data-warehouse's generated_ids.py lists them at the pinned revision. Every name is copied from the line given, with its exact characters.",
  "type": "object",
  "additionalProperties": false,
  "required": ["upstream", "revision", "file", "blob", "names_only", "bases"],
  "properties": {
    "upstream": {"const": "hackclub/data-warehouse"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "file": {"const": "orpheus_engine/defs/airtable/generated_ids.py"},
    "blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "names_only": {"type": "string"},
    "bases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "id", "line", "tables"],
        "properties": {
          "name": {"type": "string"},
          "id": {"type": "string", "pattern": "^app[A-Za-z0-9]{14}$"},
          "line": {"type": "integer", "minimum": 1},
          "tables": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "id", "line", "fields", "left_out"],
              "properties": {
                "name": {"type": "string"},
                "id": {"type": "string", "pattern": "^tbl[A-Za-z0-9]{14}$"},
                "line": {"type": "integer", "minimum": 1},
                "field_count": {"type": "integer", "minimum": 1, "description": "How many fields the table has in all, those left out included."},
                "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/field"}},
                "left_out": {"type": "string"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "line", "role", "filled_by"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "role": {"enum": ["project", "evidence", "submission", "hours", "justification", "exception", "automation", "review", "weight", "program"]},
        "filled_by": {
          "enum": ["program", "pairtime", "reviewer", "Hack Club automation"],
          "description": "Who writes the field. pairtime means the text or number comes from pairtime's justification endpoint (DESIGN 9.3), written by the program's Airtable script (WP-PG2) or pasted by its reviewer."
        },
        "handbook": {"type": "string", "description": "The field's name in the handbook, in handbook/fields.json."},
        "note": {"type": "string"}
      }
    }
  }
}
