{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Format of hackatime/endpoints.json",
  "description": "Hackatime's program-facing read endpoints as WP-PG0 captured them, and the three heartbeat endpoints WakaTime clients use, which WP-AD16 added. Every line range is at the revision named in the file, and every excerpt path names a file under excerpts/.",
  "type": "object",
  "additionalProperties": false,
  "required": ["upstream", "revision", "base_url", "time_zone", "identifier_lookup", "endpoints"],
  "properties": {
    "upstream": {"const": "hackclub/hackatime"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "base_url": {"type": "string", "pattern": "^https://"},
    "time_zone": {"type": "string", "minLength": 1},
    "identifier_lookup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "order", "rule", "my", "used_by", "trust_factor_differs"],
      "properties": {
        "source": {"$ref": "#/$defs/source"},
        "order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "rule": {"type": "string"},
        "my": {"type": "string"},
        "used_by": {"type": "array", "items": {"type": "string"}},
        "trust_factor_differs": {"type": "string"}
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 8,
      "items": {"$ref": "#/$defs/endpoint"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "lines"],
      "properties": {
        "file": {"type": "string", "minLength": 1, "description": "Path in the upstream repository."},
        "lines": {"type": "string", "pattern": "^[0-9]+(-[0-9]+)?(, [0-9]+(-[0-9]+)?)*$"},
        "excerpt": {"type": "string", "x-file-ref": true, "description": "The local file that quotes those lines, when there is one."}
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "path", "route", "action", "auth", "params", "responses"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z_]+$"},
        "method": {"enum": ["GET", "POST"]},
        "path": {"type": "string", "pattern": "^/api/"},
        "route": {"$ref": "#/$defs/source"},
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "source"],
          "properties": {
            "name": {"type": "string"},
            "source": {"$ref": "#/$defs/source"}
          }
        },
        "auth": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/credential"}},
        "params": {"type": "array", "items": {"$ref": "#/$defs/param"}},
        "responses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/response"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "how"],
      "properties": {
        "kind": {"enum": ["none", "oauth_token", "api_key", "admin_key"]},
        "how": {"type": "string"},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "param": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "in", "forms", "meaning"],
      "properties": {
        "name": {"type": "string"},
        "in": {"enum": ["path", "query", "body"]},
        "required": {"type": "boolean"},
        "forms": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "default": {"type": "string"},
        "meaning": {"type": "string"},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "when"],
      "properties": {
        "status": {"type": "integer", "minimum": 100, "maximum": 599},
        "when": {"type": "string"},
        "schema": {"type": "string", "pattern": "\\.schema\\.json$", "x-file-ref": true},
        "body": {"type": "string", "description": "For a body that isn't JSON, what it is."},
        "source": {"$ref": "#/$defs/source"}
      },
      "anyOf": [{"required": ["schema"]}, {"required": ["body"]}]
    }
  }
}
