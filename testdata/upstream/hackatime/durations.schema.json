{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Format of hackatime/durations.json",
  "description": "Heartbeat sets with the seconds each function in durations.sql should return for them. To run one: load a set's heartbeats into the heartbeats table, with deleted_at as given, call each case's function with its args, and compare with expect. For the two table functions, expect maps each returned name to its seconds.",
  "type": "object",
  "additionalProperties": false,
  "required": ["functions", "derived", "sets"],
  "properties": {
    "functions": {"type": "string", "x-file-ref": true},
    "derived": {"type": "string"},
    "sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "heartbeats", "cases"],
        "properties": {
          "name": {"type": "string"},
          "heartbeats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "user_id", "time", "project", "category", "deleted_at"],
              "properties": {
                "id": {"type": "integer", "minimum": 1},
                "user_id": {"type": "integer", "minimum": 1},
                "time": {"type": "number"},
                "project": {"type": ["string", "null"]},
                "category": {"type": ["string", "null"]},
                "deleted_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$"}
              }
            }
          },
          "cases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "function", "args", "expect", "why"],
              "properties": {
                "name": {"type": "string"},
                "function": {"enum": ["hackatime_seconds_boundary_aware", "hackatime_seconds", "hackatime_seconds_by_project", "hackatime_seconds_by_category"]},
                "args": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["user_id", "projects", "start", "end", "excluded"],
                  "properties": {
                    "user_id": {"type": "integer", "minimum": 1},
                    "projects": {"type": ["array", "null"], "items": {"type": "string"}},
                    "start": {"type": "number"},
                    "end": {"type": "number"},
                    "excluded": {"type": ["array", "null"], "items": {"type": "string"}}
                  }
                },
                "expect": {
                  "anyOf": [
                    {"type": "integer", "minimum": 0},
                    {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
                  ]
                },
                "why": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
