#
# config/secrets.env: copy this file there with mode 0600 and fill it in on
# the host (deploy/runbook.md, step 4). Never commit the filled-in copy.
#
#   install -m 0600 secrets.env.example config/secrets.env
#
# compose reads it on the host and hands each line to the pairtimed
# container as an environment variable. pairtimed and litestream.yml both
# read from there. Write values unquoted, or in single quotes when they hold
# '$', '\' or ' #'; pairtimed refuses lines compose would read differently.

# The two buckets (DESIGN 10.5 item 4). Not secret, but Litestream reads
# them from here, and `pairtimed init` copies them into pairtime.toml.
# R2's endpoint is https://<account id>.r2.cloudflarestorage.com, and its
# region is auto.
PAIRTIME_S3_ENDPOINT=
PAIRTIME_S3_REGION=auto
PAIRTIME_S3_BUCKET=
PAIRTIME_S3_SNAPSHOT_BUCKET=
# One access key with read and write on those two buckets and nothing else.
PAIRTIME_S3_ACCESS_KEY_ID=
PAIRTIME_S3_SECRET_ACCESS_KEY=

# The Hack Club Auth app's client secret; its id goes in pairtime.toml.
PAIRTIME_HCA_CLIENT_SECRET=
# Encrypts account emails at rest (DESIGN 4.4). Make it once with
#   openssl rand -hex 32
# and never change it: `pairtimed keys backup` backs it up with /data/keys.
PAIRTIME_EMAIL_KEY=

# The two Healthchecks.io check URLs (DESIGN 10.4): Litestream pings the
# first while replication works, and pairtimed the second every 5 minutes
# while /readyz passes.
PAIRTIME_LITESTREAM_HEARTBEAT_URL=
PAIRTIME_HEALTHCHECKS_URL=

# Karim's age public key, age1..., for the nightly snapshots and
# `pairtimed keys backup`. The private key never comes near this host.
PAIRTIME_AGE_RECIPIENT=
