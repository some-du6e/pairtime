#
# config/tunnel.env: copy this file there with mode 0600 and fill it in on
# the host (deploy/runbook.md, step 4). Never commit the filled-in copy.
#
#   install -m 0600 cloudflared/tunnel.env.example config/tunnel.env
#
# The token of the tunnel Karim made for <host> (DESIGN 10.5 item 2).
# cloudflared reads it from the environment, so it never appears in the
# container's command line.
TUNNEL_TOKEN=
