# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Every npm command run in web/ skips install scripts, as CI does, so a
# hijacked release's postinstall never runs with the credentials of whoever
# installs it. Nothing here needs one: the only package with a script,
# fsevents, an optional macOS file watcher, ships the binary its script would
# rebuild. `npm run <name>` still runs the script it names.
ignore-scripts=true
